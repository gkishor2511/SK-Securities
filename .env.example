# Twelve Data API key for server-side market data. Leave blank to show the
# explicit unavailable state in the market dashboard.
TWELVE_DATA_API_KEY=

# Optional contact form delivery through Resend. All three values are required
# for delivery; the API key must never use a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional WhatsApp Business Cloud API delivery. The recipient defaults to the
# company phone shown on the website (9676914932), but may be overridden.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
CONTACT_WHATSAPP_TO=919676914932

# Optional public company details shown on the site.
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
